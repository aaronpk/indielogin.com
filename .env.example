APP_NAME=IndieLogin.com
BASE_URL=http://localhost:8080/

# --- Tunnel discovery (docker only) -------------------------------------------
# Swap the tunnel backend by choosing how the coordinator finds BASE_URL.
# The cloudflared service itself always needs TUNNEL_TOKEN.
TUNNEL_TOKEN=

# static | http | file | ngrok | log
TUNNEL_DISCOVERY=static

# static discovery: the public base URL (leave as-is; matches BASE_URL).
# http/file/ngrok/log discovery: see docker/README.md for the *_URL* vars.

HTTPCLIENT_USER_AGENT=IndieLogin

# Whether anyone who signs in can register their own client IDs at /developers.
# Set to false to turn self-service registration off entirely, in which case
# client IDs have to be added to the clients table by hand. Leaving this out
# enables it.
CLIENT_REGISTRATION=true

# Warn people whose site still signs in through indieauth.com, on the way
# through. Everyone this service delegates to indieauth.com for is someone
# whose own site names it, so this is the one place they can be told in
# context. It adds a step to a working flow, so it is off unless set.
INDIEAUTH_COM_NOTICE=false

# Where that notice sends them. Leave these out and it explains the situation
# without naming anywhere.
# REPLACEMENT_NAME=IndieKey
# REPLACEMENT_URL=https://indiekey.id/

# The replacement's own client_id. When it sends someone here to prove they
# own a site that still names indieauth.com as its authorization server, the
# site's rel=me links are used instead of delegating to indieauth.com. The
# client must be registered like any other, with its redirect_uri added to
# redirect_uris if it is on another host.
# REPLACEMENT_CLIENT_ID=https://indiekey.id/

DB_HOST=127.0.0.1
DB_USER=indielogin
DB_PASS=indieloginpass
DB_NAME=indielogin

MAILGUN_KEY=key-
MAILGUN_DOMAIN=
MAILGUN_FROM=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
