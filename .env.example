APP_NAME=IndieLogin.com
BASE_URL=http://localhost:8080/

# --- Tunnel discovery (docker only) -------------------------------------------
# Swap the tunnel backend by choosing how the coordinator finds BASE_URL.
# The cloudflared service itself always needs TUNNEL_TOKEN.
TUNNEL_TOKEN=

# static | http | file | ngrok | log
TUNNEL_DISCOVERY=static

# static discovery: the public base URL (leave as-is; matches BASE_URL).
# http/file/ngrok/log discovery: see docker/README.md for the *_URL* vars.

HTTPCLIENT_USER_AGENT=IndieLogin

# Whether anyone who signs in can register their own client IDs at /developers.
# Set to false to turn self-service registration off entirely, in which case
# client IDs have to be added to the clients table by hand. Leaving this out
# enables it.
CLIENT_REGISTRATION=true

DB_HOST=127.0.0.1
DB_USER=indielogin
DB_PASS=indieloginpass
DB_NAME=indielogin

MAILGUN_KEY=key-
MAILGUN_DOMAIN=
MAILGUN_FROM=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
