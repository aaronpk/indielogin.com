#!/usr/bin/env php
<?php
/**
 * Count every month of the admin activity page that has not been counted.
 *
 * The page does this itself, a little at a time, but the first time it has to
 * go back to the first sign-in on record, which can take longer than a page
 * load should. Run this once after deploying instead:
 *
 *   php bin/count-activity
 *
 * Safe to run at any time, and from cron: months already counted are skipped,
 * and it waits for nothing if a page load is counting at the same moment.
 */

chdir(dirname(__DIR__));
require 'vendor/autoload.php';

initdb();

$activity = new App\AdminActivity;

// "Every month is counted" alone looks like nothing happened, so say what is
// there, and when it was counted: often by a page load that got there first
$summary = function() use($activity) {
  $stored = $activity->stored();
  if(!$stored)
    return 'nothing is stored yet';

  $month = fn($m) => gmdate('F Y', strtotime($m.'-01 00:00:00 UTC'));

  return sprintf('%d month%s, %s to %s, last counted %s UTC',
    $stored['months'], $stored['months'] == 1 ? '' : 's',
    $month($stored['first']), $month($stored['last']),
    substr($stored['counted'], 0, 16));
};

$pending = $activity->pending();

if(!$pending) {
  echo "Every month is counted: ".$summary().".\n";
  exit(0);
}

echo "Counting $pending month".($pending == 1 ? '' : 's')."...\n";

$start = microtime(true);
$folded = $activity->advance(PHP_INT_MAX, function($month) use($start) {
  printf("  %s  (%.1fs)\n", $month, microtime(true) - $start);
});

if($folded === false) {
  echo "Something else is counting right now. Try again in a minute.\n";
  exit(1);
}

printf("Counted %d month%s in %.1fs. Now stored: %s.\n", $folded, $folded == 1 ? '' : 's', microtime(true) - $start, $summary());
