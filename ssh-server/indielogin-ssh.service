# The IndieLogin SSH sign-in server. setup-vps.sh installs it, with the
# binary as /usr/local/bin/indielogin-ssh, its user, and its settings in
# /etc/indielogin-ssh.env (root-only, read by systemd):
#
#   SSH_SERVER_LISTEN=:22
#   INDIELOGIN_URL=https://indielogin.com
#   SSH_SERVER_API_KEY=<the same value as on indielogin.com>

[Unit]
Description=IndieLogin SSH sign-in server
After=network-online.target
Wants=network-online.target

[Service]
User=indielogin-ssh
Group=indielogin-ssh
EnvironmentFile=/etc/indielogin-ssh.env
Environment=SSH_SERVER_HOST_KEY=/var/lib/indielogin-ssh/host_ed25519_key
ExecStart=/usr/local/bin/indielogin-ssh
Restart=on-failure
RestartSec=2

# Port 22 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# It reads its host key and talks to the network; nothing else
StateDirectory=indielogin-ssh
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
